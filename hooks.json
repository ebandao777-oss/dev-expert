{
  "_comment": "通用示例配置：路径用环境变量占位符，避免硬编码机器路径。部署时设置 {{PYTHON_BIN}}（Python 解释器，如 /usr/bin/python3 或 F:\\BtSoft\\python\\python_python\\python3.exe）与 {{HOOKS_DIR}}（hook 脚本目录，可指向技能自带 hooks/ 或项目 .codebuddy/hooks/）。JSON 不支持注释，本 _comment 键仅作说明，加载器忽略即可。",
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/backup_on_write.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/guard_dirs.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/plan_guard.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/lint_on_write.py\"",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/php8_compat.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/security_scan.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/secret_scan.py\"",
            "timeout": 20
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/utf8_check.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/debug_residue.py\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "write_to_file|replace_in_file|Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/select_star.py\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "{{PYTHON_BIN}} \"{{HOOKS_DIR}}/handoff_snapshot.py\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
